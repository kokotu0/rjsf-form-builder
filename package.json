{
  "name": "@kokotu0/rjsf-form-builder",
  "version": "0.1.0",
  "description": "Visual form builder for react-jsonschema-form (RJSF) with drag-and-drop support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "form",
    "form-builder",
    "json-schema",
    "rjsf",
    "react-jsonschema-form",
    "drag-and-drop",
    "mui",
    "material-ui",
    "react19"
  ],
  "author": "kokotu0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koktu0/rjsf-form-builder.git"
  },
  "bugs": {
    "url": "https://github.com/koktu0/rjsf-form-builder/issues"
  },
  "homepage": "https://github.com/koktu0/rjsf-form-builder#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@mui/material": "^5.0.0 || ^6.0.0",
    "@mui/icons-material": "^5.0.0 || ^6.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@rjsf/core": "^5.0.0",
    "@rjsf/mui": "^5.0.0",
    "@rjsf/utils": "^5.0.0",
    "@rjsf/validator-ajv8": "^5.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/material": "^6.0.0",
    "@mui/icons-material": "^6.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@rjsf/core": "^5.0.0",
    "@rjsf/mui": "^5.0.0",
    "@rjsf/utils": "^5.0.0",
    "@rjsf/validator-ajv8": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
